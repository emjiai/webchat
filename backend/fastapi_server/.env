# Google RAG Configuration (matches backend/gemini_rag/.env structure)
# Choose Model Backend: 0 -> ML Dev, 1 -> Vertex
GOOGLE_GENAI_USE_VERTEXAI=1

# ML Dev backend config
GOOGLE_API_KEY=AIzaSyCKhRB4-MYU1ADh6zFTQ4R-GNlY4bxo9S8

# Vertex backend config
# RAG Engine only works with Vertex. So we should configure it to use Vertex:
GOOGLE_SERVICE_ACCOUNT_FILE=C:/Users/jideo/Documents/websites/webchat/backend/fastapi_server/app/credentials/service-account.json 
GOOGLE_APPLICATION_CREDENTIALS=C:/Users/jideo/Documents/websites/webchat/backend/fastapi_server/app/credentials/service-account.json
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_CLOUD_BUCKET = content-genius-bucket-new
GOOGLE_CLOUD_PROJECT=gen-lang-client-0857822084


# Existing corpus in Vertex RAG Engine to be used by RAG agent
# e.g. projects/123/locations/us-central1/ragCorpora/456
RAG_CORPUS=projects/gen-lang-client-0857822084/locations/europe-west2/ragCorpora/2305843009213693952

# Staging bucket name for ADK agent deployment to Vertex AI Agent Engine (Shall respect this format gs://your-bucket-name)
STAGING_BUCKET=content-genius-bucket-new
# Agent Engine ID in the following format: projects/<PROJECT_NUMBER>/locations/us-central1/reasoningEngines/<AGENT_ENGINE_ID>
AGENT_ENGINE_ID=YOUR_VALUE_HERE

# FastAPI Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=True

# CORS Configuration
CORS_ORIGINS=["http://localhost:3005"]

# Logging
LOG_LEVEL=INFO

# Security (Optional - for future enhancement)
API_KEY_HEADER=X-API-Key
RATE_LIMIT_PER_MINUTE=60